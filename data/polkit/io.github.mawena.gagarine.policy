<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Gagarine</vendor>
  <vendor_url>https://github.com/mawena/gagarine</vendor_url>
  <action id="io.github.mawena.gagarine.administrer">
    <description>Administrer Gagarine</description>
    <message>Une authentification est nécessaire pour modifier les réglages ou le service Gagarine, ou agir sur les programmes d’un autre utilisateur.</message>
    <icon_name>io.github.mawena.Gagarine</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/gagarine</annotate>
  </action>
</policyconfig>
