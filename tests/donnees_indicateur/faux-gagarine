#!/bin/sh
# Faux `gagarine` pour les essais de l'indicateur : rend des JSON conformes à docs/conception-1.1.0.md.
# FAUX_GAGARINE_MODE : normal (défaut), vigilance, fige, panne (code 1), invalide (pas du JSON), lent (dort 30 s).
# FAUX_GAGARINE_MENAGE : normal (deux candidats), vide, absent (commande inconnue, code 2) ; commandes de docs/conception-1.2.0.md.
# FAUX_GAGARINE_FUITE=oui : contrats de la 1.3.0 (docs/conception-1.3.0.md) : `fuites` dans `etat --json`, `en_cours` et
# `paralleles` dans `file --etat --json` (trois travaux dont deux en cours). Sans cette variable : cœur 1.2.x.
mode="${FAUX_GAGARINE_MODE:-normal}"
journal="${FAUX_GAGARINE_JOURNAL:-}"
[ -n "$journal" ] && echo "$@" >> "$journal"
case "$mode" in
  panne) echo "erreur simulée" >&2; exit 1 ;;
  invalide) echo "ceci n'est pas du JSON"; exit 0 ;;
  lent) sleep 30 ;;
esac
pct=75.2; dispo=3620; figes='[]'
[ "$mode" = vigilance ] && { pct=88.0; dispo=1750; }
[ "$mode" = fige ] && { pct=96.5; dispo=510; figes='[{"pid": 4242, "nom": "python3", "depuis": 1762785000.5, "memoire_mo": 9100, "commande": "python3 -m pytest", "utilisateur": "'"$(id -un)"'", "bride": true}]'; }
fuites=''; file_en_tete=''; travaux_extra=''
if [ "$FAUX_GAGARINE_FUITE" = oui ]; then
  fuites=', "fuites": [{"pid": 6001, "nom": "python3", "pente_mo_min": 210, "depuis": "2026-11-10T14:23:00+0000"}, {"pid": 7301, "nom": "node", "pente_mo_min": 120, "depuis": "2026-11-10T14:26:00+0000"}]'
  file_en_tete=', "paralleles": 3, "en_cours": 2'
  travaux_extra=', {"ticket": "1762785050000-1280.json", "position": 2, "nom": "tests", "pid": 1280, "depuis": "2026-11-10T14:31:00.000Z", "etat": "en cours", "ram": 2, "coeurs": 2, "priorite": "fond", "besoin_go": 2, "commande": "pytest", "unite": null, "sortie": null, "source": "gagarine"}, {"ticket": "1762785100000-1301.json", "position": 3, "nom": "rendu", "pid": 1301, "depuis": "2026-11-10T14:32:00.000Z", "etat": "en attente", "ram": 6, "coeurs": 8, "priorite": "normal", "besoin_go": 6, "motif": "2 travaux en cours", "commande": "ffmpeg", "unite": null, "sortie": null, "source": "gagarine"}'
fi
case "$1 $2" in
  "etat --json")
    cat <<JSON
{"version": "1.1.0", "date": "2026-11-10T14:30:00+0000",
 "ram": {"pourcent": $pct, "total_mo": 14600, "disponible_mo": $dispo},
 "swap": [{"nom": "/dev/zram0", "type": "partition", "taille_mo": 15237, "utilise_mo": 0, "priorite": 100, "zram": true},
          {"nom": "/dev/nvme0n1p7", "type": "partition", "taille_mo": 10239, "utilise_mo": 6041, "priorite": -2, "zram": false}],
 "reglages": {"seuil": 95, "urgence": 98, "vigilance": 85, "grace": 10, "vidage_max": 60, "delai_fige": 600,
              "reste_si_repris": 256, "notifications": true, "proteges": ""},
 "fichier_reglages": "/etc/gagarine.conf", "service": {"etat": "active", "actif_au_demarrage": true},
 "dossier_etat": "/var/lib/gagarine", "figes": $figes, "plus_gros": [], "file": {"travaux": 1}$fuites}
JSON
    ;;
  "file --etat")
    cat <<JSON
{"ram_disponible_go": 3.6, "charge": 2.1, "coeurs": 14, "dossier": "/tmp/file-attente-travaux-lourds"$file_en_tete,
 "travaux": [{"ticket": "1762785000000-1234.json", "position": 1, "nom": "rendu vidéo", "pid": 1234,
              "depuis": "2026-11-10T14:30:00.000Z", "etat": "en cours", "ram": 4, "coeurs": 4,
              "commande": "ffmpeg", "unite": null, "sortie": null, "source": "gagarine"}$travaux_extra]}
JSON
    ;;
  "menage --json")
    [ "$FAUX_GAGARINE_MENAGE" = absent ] && { echo "commande inconnue" >&2; exit 2; }
    if [ "$FAUX_GAGARINE_MENAGE" = vide ]; then
      echo '{"auto": true, "delai_min": 30, "candidats": []}'
    else
      cat <<JSON
{"auto": true, "delai_min": 30, "candidats": [
 {"id": "5551", "type": "gradle", "nom": "Démon Gradle", "pid": 5551, "memoire_mo": 3100, "inactif_depuis_s": 2640, "action": "arreter", "auto": true},
 {"id": "ollama:llama3.1:8b", "type": "ollama", "nom": "llama3.1:8b", "pid": null, "memoire_mo": 5400, "inactif_depuis_s": 1260, "action": "decharger", "auto": true}]}
JSON
    fi
    ;;
  "menage arreter") exit 0 ;;
  reprendre*|arreter*) exit 0 ;;
  *) echo "commande inconnue" >&2; exit 2 ;;
esac
