            {"pid": 3100, "nom": "chrome", "rss_mo": 2900, "swap_mo": 420, "utilisateur": "charles-gamligo", "protege": False},
            {"pid": 4242, "nom": "python3", "rss_mo": 120, "swap_mo": 8980, "utilisateur": "charles-gamligo", "protege": False},
            {"pid": 2210, "nom": "gnome-shell", "rss_mo": 1210, "swap_mo": 90, "utilisateur": "charles-gamligo", "protege": True},
            {"pid": 5120, "nom": "code", "rss_mo": 1100, "swap_mo": 300, "utilisateur": "charles-gamligo", "protege": False},
            {"pid": 880, "nom": "dockerd", "rss_mo": 640, "swap_mo": 20, "utilisateur": "root", "protege": True},
            {"pid": 6001, "nom": "node", "rss_mo": 610, "swap_mo": 0, "utilisateur": "charles-gamligo", "protege": False},
            {"pid": 1203, "nom": "postgres", "rss_mo": 380, "swap_mo": 10, "utilisateur": "postgres", "protege": True},
            {"pid": 7301, "nom": "firefox", "rss_mo": 350, "swap_mo": 40, "utilisateur": "charles-gamligo", "protege": False},
