def historique(depuis):
    """Historique réaliste : une mesure par minute (24 h) ou moyennée par 10 min (7 j), incidents, plus gros, travaux."""
    duree = {'5min': 300, '1h': 3600, '24h': 86400, '7j': 7 * 86400}.get(depuis, 86400)
    pas = 60 if duree <= 86400 else 600
    points = []
    for i in range(int(duree // pas)):
        t = maintenant - duree + (i + 1) * pas
        jour = (t % 86400) / 86400
        ram = 52 + 18 * abs(((t / 3600) % 24) - 12) / 12 * -1 + 22 + 6 * ((i * 7) % 5) / 5
        if (int(t) // pas) % 211 < 4:
            ram = 94 + ((int(t) // pas) % 3)       # pics rares, proches du seuil
        points.append({"date": iso(t), "ram": round(min(ram, 97.4), 1), "swap_mo": int(1500 + 4000 * jour),
                       "zram_mo": int(900 + 800 * jour), "pression": round(max(0.0, ram - 85) / 3, 1)})
    incidents = [
        {"date": iso(maintenant - duree * 0.18), "source": "gagarine", "action": "fige", "pid": 3900, "nom": "node", "ram": 95.9,
         "memoire": 4200 * 1048576, "declencheur": "anticipation"},
        {"date": iso(maintenant - duree * 0.18 + 40), "source": "gagarine", "action": "arrete", "pid": 3900, "nom": "node",
         "ram": 97.2, "memoire": 4200 * 1048576, "raison": "la RAM n’est pas redescendue"},
        {"date": iso(maintenant - duree * 0.55), "source": "gagarine", "action": "fige", "pid": 4242, "nom": "python3",
         "ram": 95.4, "memoire": 9100 * 1048576, "declencheur": "pression"},
        {"date": iso(maintenant - duree * 0.83), "source": "file", "action": "limite", "nom": "tests", "declare": 1, "limite": 3,
         "pic_go": 3.2},
    ] if duree >= 86400 else []
    return {"depuis_s": duree, "pas_s": pas, "points": points, "incidents": incidents,
            "gros": [{"nom": "chrome", "pic_mo": 4100, "minutes": 840}, {"nom": "python3", "pic_mo": 9100, "minutes": 35},
                     {"nom": "code", "pic_mo": 2300, "minutes": 620}] if duree >= 86400 else [],
            "travaux": [{"nom": "rendu vidéo", "date": iso(maintenant - 7200), "duree": 754.0, "code": 0, "pic_go": 3.8},
                        {"nom": "tests de non-régression", "date": iso(maintenant - 30000), "duree": 1380.0, "code": 1, "pic_go": 6.3},
                        {"nom": "export PDF", "date": iso(maintenant - 90000), "duree": 312.0, "code": 0, "pic_go": 1.4},
                        {"nom": "gradle build", "date": iso(maintenant - 200000), "duree": 205.0, "code": 0, "pic_go": 5.1}]
            if mode != 'vide' else []}


