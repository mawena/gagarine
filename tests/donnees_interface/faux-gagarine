#!/usr/bin/env python3
"""Faux `gagarine` pour développer et photographier l'interface : rend des JSON réalistes (contrats de docs/conception-1.1.0.md).

Variables : FAUX_MODE = normal (défaut) | vide (rien de figé, file vide) | erreur (sortie invalide) | lent (dort 30 s)
            FAUX_RAM = pourcentage de RAM à annoncer (défaut : lu dans /proc/meminfo)
Les actions (reprendre, arrêter, annuler, service, réglages, essai) ne font rien et le disent.
"""
import json
import os
import sys
import time
from datetime import datetime, timedelta, timezone

mode = os.environ.get('FAUX_MODE', 'normal')
args = sys.argv[1:]
maintenant = time.time()


def iso(t, z=False):
    d = datetime.fromtimestamp(t, timezone.utc)
    return d.strftime('%Y-%m-%dT%H:%M:%S.000Z') if z else d.strftime('%Y-%m-%dT%H:%M:%S+0000')


def meminfo():
    v = {}
    for l in open('/proc/meminfo'):
        k, _, r = l.partition(':')
        v[k] = int(r.split()[0])
    total, dispo = v['MemTotal'] / 1024, v['MemAvailable'] / 1024
    if os.environ.get('FAUX_RAM'):
        dispo = total * (1 - float(os.environ['FAUX_RAM']) / 100)
    return total, dispo


def etat():
    total, dispo = meminfo()
