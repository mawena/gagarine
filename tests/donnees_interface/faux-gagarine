def fichier_etat():
    total, dispo = meminfo()
    travaux = [] if mode == 'vide' else [
        {"ticket": "1762785000000-1234.json", "position": 1, "nom": "rendu vidéo", "pid": 1234, "depuis": iso(maintenant - 754, True),
         "etat": "en cours", "ram": 4, "coeurs": 4, "commande": "ffmpeg -i montage.mkv -c:v libx264 -crf 18 sortie.mp4",
         "unite": "gagarine-travail-1762785000000-1234.scope",
         "sortie": os.path.join(os.path.dirname(os.path.abspath(__file__)), 'sortie-exemple.log'), "source": "gagarine"},
        {"ticket": "1762785100000-1301.json", "position": 2, "nom": "tests de non-régression", "pid": 1301,
         "depuis": iso(maintenant - 95, True), "etat": "en attente", "ram": 6, "coeurs": 8,
         "commande": "python3 -m unittest discover -s tests -t .", "unite": None, "sortie": None, "source": "autre"}]
    return {"ram_disponible_go": round(dispo / 1024, 1), "charge": 2.1, "coeurs": 14,
            "dossier": "/tmp/file-attente-travaux-lourds", "travaux": travaux}


