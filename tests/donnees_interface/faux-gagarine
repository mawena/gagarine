def main():
    if mode == 'lent':
        time.sleep(30)
    if mode == 'erreur':
        print('ceci n’est pas du JSON')
        return 0
    if not args:
        print('faux gagarine'); return 0
    c = args[0]
    if c == 'etat':
        print(json.dumps(etat())); return 0
    if c == 'journal':
        n = int(args[args.index('-n') + 1]) if '-n' in args else 50
        print(json.dumps(journal(n))); return 0
    if c == 'file' and '--etat' in args:
        print(json.dumps(fichier_etat())); return 0
    if c == 'file' and len(args) > 1 and args[1] == 'annuler':
        print(f'Travail {args[2]} annulé (faux).'); return 0
    if c == 'file':
        print('Faux travail : ' + ' '.join(args[1:]))
        time.sleep(1); return 0
    if c == 'reglages':
        if '--ecrire' in args:
            print('Réglages enregistrés (faux) : ' + ' '.join(args[args.index('--ecrire') + 1:])); return 0
        print(json.dumps({"fichier": "/etc/gagarine.conf", "reglages": etat()["reglages"]})); return 0
    if c in ('reprendre', 'arreter', 'service'):
        print(f'{c} {" ".join(args[1:])} : fait (faux).'); return 0
    if c == 'essai':
        for l in ['Essai de Gagarine 1.1.0 (service système, root)', 'RAM de départ 52,0 % ; seuil d’essai 57,0 %',
                  'programme d’essai : 400 Mo', 'programme d’essai : 1200 Mo', 'figé (T), rangé dans le swap',
                  'arrêté par Gagarine', '--- verdict ---', 'OK  figé', 'OK  rangé dans le swap', 'OK  arrêté']:
            print(l, flush=True); time.sleep(0.3)
        return 0
    print('commande inconnue', file=sys.stderr); return 2


sys.exit(main())
