#!/usr/bin/env python3
"""Interface graphique de Gagarine (GTK 4 + libadwaita). Voir docs/conception-1.1.0.md, section 4."""
import os
import sys

_ici = os.path.dirname(os.path.realpath(__file__))
# installé dans /usr/bin : les modules sont dans /usr/share/gagarine ; dans le dépôt : le dossier parent de bin/
sys.path.insert(0, '/usr/share/gagarine' if _ici == '/usr/bin' else os.path.dirname(_ici))


def _dependances():
    """Vérifie PyGObject, GTK 4 et libadwaita ; sinon dit clairement quoi installer."""
    manque = []
    try:
        import gi
    except ImportError:
        sys.exit('Gagarine : il manque PyGObject. Installez le paquet : sudo apt install python3-gi gir1.2-gtk-4.0 gir1.2-adw-1')
    for espace, version, paquet in (('Gtk', '4.0', 'gir1.2-gtk-4.0'), ('Adw', '1', 'gir1.2-adw-1')):
        try:
            gi.require_version(espace, version)
            __import__('gi.repository', fromlist=[espace])
            getattr(__import__('gi.repository', fromlist=[espace]), espace)
        except (ValueError, ImportError):
            manque.append(paquet)
    if manque:
        sys.exit('Gagarine : l’interface graphique a besoin de ' + ' et '.join(manque) + '.\n'
                 'Installez-les : sudo apt install ' + ' '.join(manque))


if __name__ == '__main__':
    _dependances()
    from gagarine.interface.application import principal
    sys.exit(principal(sys.argv))
