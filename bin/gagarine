#!/usr/bin/python3
"""Lanceur de Gagarine, garde-RAM du poste. Tout le code est dans le paquet « gagarine » (voir docs/conception-1.1.0.md).

Installé dans /usr/bin, il cherche le paquet dans /usr/share/gagarine ; lancé depuis le dépôt, dans le dossier parent
de bin/.
"""
import os
import sys

_ici = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, '/usr/share/gagarine' if _ici == '/usr/bin' else os.path.dirname(_ici))

from gagarine.cli import main  # noqa: E402

if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
